# Supabase project used for site content and image uploads (Settings -> API in the Supabase dashboard).
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Lets the admin API save, publish and upload. Never prefix with PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard login (server-only).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-long-password
# Long random string used to sign login sessions, e.g. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=long-random-string
