---
import '../styles/global.css';
import '../styles/motion.css';
import settings from '../content/settings.json';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = '/images/truck-highway.jpg', noindex = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/wash/', label: 'AITS Wash' },
  { href: '/fleet/', label: 'Fleet Program' },
  { href: '/vision/', label: 'AITS Vision' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AITS · All India Truckshed" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#082D58" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,600..800&family=Public+Sans:wght@400;600;700&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: settings.companyName,
      alternateName: 'AITS',
      url: 'https://aits.services/',
      logo: 'https://aits.services/images/logo.png',
      ...(settings.email ? { email: settings.email } : {}),
      ...(settings.phone ? { telephone: settings.phone } : {}),
    })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {settings.previewBanner && <div class="preview-bar" role="note">{settings.previewBannerText}</div>}
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label="AITS home">
          <img src="/images/logo.png" alt="AITS · All India Truckshed" width="520" height="122" />
        </a>
        <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Menu">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
        <nav class="nav" id="site-nav" data-open="false" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a class="btn btn--primary" href="/contact/" aria-current={isCurrent('/contact/') ? 'page' : undefined}>Contact</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <img src="/images/logo-white.png" alt="AITS · All India Truckshed" width="520" height="122" loading="lazy" />
          <p class="footer-line">{settings.brandLine}</p>
        </div>
        <div>
          <h2>Pages</h2>
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
        <div>
          <h2>Contact</h2>
          <ul>
            {settings.whatsapp && <li><a href={`https://wa.me/${settings.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener">WhatsApp: {settings.whatsapp}</a></li>}
            {settings.email && <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>}
            {settings.phone && <li><a href={`tel:${settings.phone.replace(/\s/g, '')}`}>{settings.phone}</a></li>}
            {settings.address && <li>{settings.address}</li>}
            <li><a href="/contact/#inquiry">Send an inquiry</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-legal">
        <div class="wrap">
          <span>© {year} {settings.companyName}</span>
          <span>aits.services</span>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/motion.ts';
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const nav = document.getElementById('site-nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.setAttribute('data-open', String(!open));
      });
    </script>
  </body>
</html>
