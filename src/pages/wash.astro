---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import Road from '../components/Road.astro';
import Notice from '../components/Notice.astro';
import Status from '../components/Status.astro';
import c from '../content/wash.json';
---
<Base title={c.seo.title} description={c.seo.description} image={c.hero.image}>
  <Hero eyebrow={c.hero.eyebrow} title={c.hero.title} lead={c.hero.lead} image={c.hero.image} imageAlt={c.hero.imageAlt} caption={c.hero.imageCaption} square>
    <div class="hero-actions">
      <a class="btn btn--primary" href="#how-it-works">How it works</a>
      <a class="btn btn--ghost" href="/fleet/">Fleet Program</a>
    </div>
  </Hero>
  <Notice text={c.notice} />

  <section class="section section--white">
    <div class="wrap">
      <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,11.5rem),1fr))">
        {c.pillars.map((p) => (
          <div class="feature">
            <Status label={p.status} />
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--navy" id="how-it-works">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{c.system.eyebrow}</span>
        <h2>{c.system.title}</h2>
      </div>
      <ol class="system" aria-label="How the automated washing system works">
        {c.system.steps.map((s) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}
      </ol>
      <div class="sequence">
        <h3>{c.system.sequenceTitle}</h3>
        <ol>{c.system.sequence.map((s) => <li>{s}</li>)}</ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <img src={c.diversity.image} alt={c.diversity.imageAlt} width="995" height="1491" loading="lazy" />
      <div>
        <h2>{c.diversity.title}</h2>
        <ul class="ticks">{c.diversity.items.map((i) => <li>{i}</li>)}</ul>
        <p class="closing">{c.diversity.closing}</p>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{c.water.eyebrow}</span>
        <h2>{c.water.title}</h2>
      </div>
      <div class="grid grid--4">
        {c.water.items.map((i) => (
          <div class="feature">
            <Status label={i.status} />
            <h3>{i.title}</h3>
            <p>{i.text}</p>
          </div>
        ))}
      </div>
      {c.water.note && <p class="note" style="margin-top:2rem">{c.water.note}</p>}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{c.driver.eyebrow}</span>
        <h2>{c.driver.title}</h2>
      </div>
      <Road steps={c.driver.journey} label="Driver journey at AITS" />
      <div style="margin-top:clamp(40px,5vw,56px)">
        <h3 style="margin-bottom:1rem">{c.driver.facilitiesTitle}</h3>
        <ul class="chips">{c.driver.facilities.map((f) => <li>{f}</li>)}</ul>
      </div>
    </div>
  </section>

  <CtaBand title={c.cta.title} text={c.cta.text} buttonText={c.cta.buttonText} href="/fleet/" />
</Base>
