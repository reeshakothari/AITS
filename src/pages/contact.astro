---
import View from '../views/ContactView.astro';
import { loadContent } from '../lib/content';

const content = await loadContent('published');
// Short CDN cache so a publish from the admin shows up within seconds.
Astro.response.headers.set('Vercel-CDN-Cache-Control', 's-maxage=10, stale-while-revalidate=60');
---
<View content={content} />
