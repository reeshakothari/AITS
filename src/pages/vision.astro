---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Hero from '../components/Hero.astro';
import Status from '../components/Status.astro';
import c from '../content/vision.json';
const isCurrent = (s: string) => !/planned|proposed|future/i.test(s);
---
<Base title={c.seo.title} description={c.seo.description} image={c.hero.image}>
  <Hero eyebrow={c.hero.eyebrow} title={c.hero.title} lead={c.hero.lead} bg={c.hero.image} />

  <section class="section section--white">
    <div class="wrap">
      <div class="vision-notice" role="note">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v5M12 16.5v.5" stroke-linecap="round"/></svg>
        <span>{c.notice}</span>
      </div>

      <div class="section-head" style="margin-top:clamp(40px,5vw,56px)">
        <h2>{c.stagesTitle}</h2>
      </div>
      <ol class="stages" aria-label="AITS vision stages">
        {c.stages.map((s, i) => (
          <li class:list={['stage', { 'stage--current': isCurrent(s.status) }]} style={`--h:${i}`}>
            <span class="num">Stage {i + 1}</span>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
            <Status label={s.status} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--navy">
    <div class="wrap">
      <div class="section-head"><h2>{c.rolloutTitle}</h2></div>
      <ol class="rollout" aria-label="Expansion path">{c.rollout.map((r) => <li>{r}</li>)}</ol>
    </div>
  </section>

  <CtaBand title={c.cta.title} text={c.cta.text} buttonText={c.cta.buttonText} href="/contact/" />
</Base>
