---
import { adminConfigured, hasSession } from '../../lib/auth';
import { demoMode } from '../../lib/content';
import '../../styles/global.css';
import '../../styles/editor.css';

const next = Astro.url.searchParams.get('next') ?? '';
const target = next.startsWith('/admin/edit/') ? next : '/admin/edit/home/';
if (demoMode() || (await hasSession(Astro.cookies))) return Astro.redirect(target);
Astro.response.headers.set('Cache-Control', 'no-store');
const configured = adminConfigured();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>AITS Admin Dashboard</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,600..800&family=Public+Sans:wght@400;600;700&display=swap" />
  </head>
  <body class="login-page">
    <main class="login">
      <img src="/images/logo.png" alt="AITS · All India Truckshed" width="260" height="61" />
      <h1>Admin Dashboard</h1>
      {configured ? (
        <form id="login" data-next={target}>
          <div class="field"><label for="email">Email</label><input id="email" type="email" autocomplete="username" required /></div>
          <div class="field"><label for="password">Password</label><input id="password" type="password" autocomplete="current-password" required /></div>
          <p class="form-error" role="alert" hidden></p>
          <button class="btn btn--primary" type="submit">Log in</button>
        </form>
      ) : (
        <p class="form-error">Admin login is not set up. Add ADMIN_EMAIL, ADMIN_PASSWORD and ADMIN_SESSION_SECRET to the environment.</p>
      )}
    </main>
    <script>
      const form = document.getElementById('login') as HTMLFormElement | null;
      const error = document.querySelector<HTMLElement>('.form-error');
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const button = form.querySelector('button')!;
        button.disabled = true;
        const res = await fetch('/admin/api/login/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: (document.getElementById('email') as HTMLInputElement).value,
            password: (document.getElementById('password') as HTMLInputElement).value,
          }),
        }).catch(() => null);
        if (res?.ok) { location.replace(form.dataset.next!); return; }
        const body = res ? await res.json().catch(() => ({})) : {};
        if (error) { error.textContent = body.error ?? 'Could not reach the server. Check your connection and try again.'; error.hidden = false; }
        button.disabled = false;
      });
    </script>
  </body>
</html>
