---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | AITS" description="This page could not be found." noindex>
  <section class="section">
    <div class="wrap" style="max-width:44rem">
      <span class="eyebrow">404</span>
      <h1>Page not found</h1>
      <p class="lead" style="margin-top:1rem">The page you are looking for does not exist or has moved.</p>
      <div class="hero-actions"><a class="btn btn--outline" href="/">Back to home</a></div>
    </div>
  </section>
</Base>
