---
// Full-width "planned" notice shown under a page hero.
import { editor } from '../lib/edit';
interface Props { text?: string; path: string; label: string }
const { text, path, label } = Astro.props;
const E = editor(Astro.locals);
---
{(text || E.on) && (
  <div class="plan-bar" role="note">
    <div class="wrap">
      <span class="status" {...E.t('global.plannedLabel')}>{label}</span>
      <p {...E.t(path)}>{text}</p>
    </div>
  </div>
)}
