---
// A numbered journey drawn as a road with lane markings. Horizontal on desktop, vertical on mobile.
// On desktop a small truck drives the road when it scrolls into view (see motion.css).
import { editor } from '../lib/edit';
interface Props {
  steps: { title: string; text?: string }[];
  label: string;
  /** Content path of the steps array */
  path: string;
}
const { steps, label, path } = Astro.props;
const E = editor(Astro.locals, path);
---
<div class="road-wrap" style={`--steps:${steps.length}`}>
  <span class="road-truck" aria-hidden="true">
    <svg width="46" height="26" viewBox="0 0 46 26">
      <rect x="1" y="2" width="27" height="15" rx="1.5" fill="#2563EB" />
      <path d="M29 6h8.5l5.5 5.5V17H29z" fill="#F8FAFC" stroke="#082D58" stroke-width="1.5" />
      <path d="M32 8.5h5l3 3h-8z" fill="#082D58" />
      <circle cx="9" cy="19.5" r="3.6" fill="#1F2937" stroke="#F8FAFC" stroke-width="1.6" />
      <circle cx="21" cy="19.5" r="3.6" fill="#1F2937" stroke="#F8FAFC" stroke-width="1.6" />
      <circle cx="37" cy="19.5" r="3.6" fill="#1F2937" stroke="#F8FAFC" stroke-width="1.6" />
    </svg>
  </span>
  <ol class="road road--end" aria-label={label} {...(E.on ? { 'data-e-list': path } : {})}>
    {steps.map((s, i) => (
      <li style={`--i:${i}`}>
        <h3 {...E.t(`${i}.title`)}>{s.title}</h3>
        {(s.text || E.on) && <p {...E.t(`${i}.text`)}>{s.text}</p>}
      </li>
    ))}
  </ol>
</div>
